DATABASE_URL=mysql+pymysql://user:password@localhost/fly_anywhere

# Docker Compose 数据库与本机监听端口（生产环境请替换密码）
MYSQL_DATABASE=fly_anywhere
MYSQL_USER=fly_anywhere
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_another_strong_password
APP_PORT=18000

# LangChain 使用的 OpenAI 或 OpenAI 兼容模型
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=
AI_MODEL=gpt-4.1-mini
AI_PROVIDER=openai

# DeepSeek 官方接口示例（不要在本文件填写真实密钥）
# OPENAI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash

# 也可使用 Anthropic 或 Anthropic 兼容服务
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Tavily 联网搜索
TAVILY_API_KEY=tvly-your_tavily_api_key

# 结构化机票报价数据源，按 SerpApi → Amadeus → Tavily 自动降级
SERPAPI_API_KEY=
RAPIDAPI_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# 测试环境：https://test.api.amadeus.com；生产环境：https://api.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com

# 旧版定时价格监控配置（可选）
API_KEY=
API_SECRET=
API_SOURCE=aviationstack
SCRAPE_INTERVAL_HOURS=24

# 使用 HTTPS 部署时设为 true，限制登录 Cookie 仅通过 HTTPS 发送
AUTH_COOKIE_SECURE=false

# 每轮定时抓取完成后发送最近 90 天 PNG 走势图
EMAIL_ENABLED=false
EMAIL_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
